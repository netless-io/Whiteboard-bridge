{
  "name": "whiteboard-bridge",
  "version": "2.15.0",
  "main": "index.js",
  "private": true,
  "browserslist": [
    "Android 4.4",
    "iOS 9"
  ],
  "scripts": {
  "bundle": "webpack",
  "prebundle": "yarn sync-foundation-worker",
  "prebuild": "yarn sync-foundation-worker",
  "prebuildDev": "yarn sync-foundation-worker",
  "precheck": "yarn sync-foundation-worker",
    "start": "webpack-dev-server --mode development --host local-ip --hot",
    "sync-foundation-worker:generate": "white-web-sdk-sync-foundation-worker --out .generated/foundation-worker.js --manifest .generated/foundation-worker.manifest.json --required --target es5",
    "patch-foundation-worker": "node scripts/patch-foundation-worker.js",
    "sync-foundation-worker": "yarn sync-foundation-worker:generate && yarn patch-foundation-worker",
    "build": "tsc && webpack --mode production && touch ./build/$(git rev-parse --short HEAD) && git status -s >> ./build/$(git rev-parse --short HEAD)",
    "buildDev": "tsc && webpack --mode development && touch ./build/$(git rev-parse --short HEAD) && git status -s >> ./build/$(git rev-parse --short HEAD)",
    "check": "tsc && yarn test:background-image-view-id",
    "precy:server": "yarn sync-foundation-worker",
    "cy:server": "webpack-dev-server --mode development --host localhost --port 8760",
    "cy:run": "cypress run",
    "cy:test": "start-server-and-test cy:server http-get://localhost:8760 cy:run",
    "test:background-image-view-id": "node scripts/test-background-image-view-id.js"
  },
  "resolutions": {
    "**/video.js": "7.10.0"
  },
  "dependencies": {
    "@netless/app-slide": "^0.2.100-alpha.0",
    "@netless/appliance-plugin": "1.1.42-beta.2",
    "@netless/combine-player": "^1.1.1",
    "@netless/cursor-tool": "^0.1.1",
    "@netless/iframe-bridge": "2.1.9",
    "@netless/slide-rtc-plugin": "1.3.1",
    "@netless/synced-store": "^2.0.3",
    "@netless/video-js-plugin": "0.3.8",
    "@netless/webview-bridge": "^0.1.11",
    "@netless/white-audio-plugin": "^1.2.4",
    "@netless/white-audio-plugin2": "^2.0.4",
    "@netless/white-prepare": "^1.0.2",
    "@netless/white-video-plugin": "^1.2.4",
    "@netless/white-video-plugin2": "^2.0.4",
    "@netless/window-manager": "1.0.19",
    "agora-foundation": "3.11.1-rc.1 || 3.11.1",
    "buffer": "^6.0.3",
    "core-js": "^3.33.3",
    "html2canvas": "^1.3.3",
    "jspdf": "^2.5.1",
    "promise.any": "^2.0.1",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "whatwg-fetch": "^3.0.0",
    "white-web-sdk": "2.16.57"
  },
  "devDependencies": {
    "@babel/core": "^7.7.4",
    "@babel/plugin-proposal-class-properties": "^7.7.4",
    "@babel/plugin-proposal-object-rest-spread": "^7.7.4",
    "@babel/plugin-transform-modules-commonjs": "^7.15.0",
    "@babel/preset-env": "^7.7.4",
    "@babel/preset-react": "^7.7.4",
    "@babel/preset-typescript": "^7.7.4",
    "@netless/whiteboard-bridge-types": "^0.1.13",
    "@types/css-font-loading-module": "^0.0.4",
    "@types/react": "^16.9.13",
    "@types/react-dom": "^16.9.4",
    "@types/uuid": "^7.0.3",
    "babel-loader": "^8.0.6",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^3.2.0",
    "css-minimizer-webpack-plugin": "^3.4.1",
    "cypress": "^10.0.2",
    "cypress-log-to-output": "^1.1.2",
    "esbuild": "^0.12.15",
    "file-loader": "^5.0.2",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.5.2",
    "start-server-and-test": "^1.14.0",
    "style-loader": "^1.0.0",
    "terser-webpack-plugin": "^5.3.0",
    "thread-loader": "^3.0.4",
    "tslint": "^5.20.1",
    "typescript": "^4.5.4",
    "webpack": "^5.67.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
